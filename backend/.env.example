# ElfSec backend — izole ENV örneği
# Bunu kopyala:  copy .env.example .env   (Windows) / cp .env.example .env (Linux)
# .env dosyası .gitignore'da, GitHub'a ASLA yüklenmez.
# NOT: ElfSec API anahtarı kullanmaz — analiz %100 yereldir. Tek gizli bilgi IMAP şifrenizdir.

# --- IMAP (e-posta çekme) ---
IMAP_HOST=imap.gmail.com
IMAP_USER=ornek@gmail.com
IMAP_PASSWORD=uygulama-sifresi-buraya
IMAP_FOLDER=INBOX
IMAP_PORT=993

# --- TOOL ---
ENV=dev

# --- OAuth2 (önerilir: bir kez tarayıcı onayı, şifre yok) ---
# Windows hazır hesabı sessizce devralma YOKTUR — herkes kendi kaydını açar.
# Outlook: Azure Portal → App registrations (public client) → Application ID
# Gmail:   Google Cloud → OAuth client (Desktop) → Client ID
# Sonra: elfsec config login --provider outlook|gmail
OAUTH_PROVIDER=
MS_CLIENT_ID=
GOOGLE_CLIENT_ID=
# Refresh-token'lar `config login` ile şifreli (ENC) yazılır, elle doldurmayın:
# OAUTH_REFRESH_OUTLOOK=
# OAUTH_REFRESH_GMAIL=

# --- Alternatif: uygulama şifresi (OAuth yoksa) ---
# IMAP_PASSWORD=...
