# ElfSec backend — izole ENV örneği
# Bunu kopyala:  copy .env.example .env   (Windows) / cp .env.example .env (Linux)
# .env dosyası .gitignore'da, GitHub'a ASLA yüklenmez.
# NOT: ElfSec API anahtarı kullanmaz — analiz %100 yereldir. Tek gizli bilgi IMAP şifrenizdir.

# --- IMAP (e-posta çekme) ---
IMAP_HOST=imap.gmail.com
IMAP_USER=ornek@gmail.com
IMAP_PASSWORD=uygulama-sifresi-buraya
IMAP_FOLDER=INBOX
IMAP_PORT=993

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# API_TOKEN boşsa /api/* korumasızdır (yalnızca yerel kullanım).
# LAN'a açıyorsanız doldurun: istemci Authorization: Bearer <token> gönderir.
API_TOKEN=
ENV=dev
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_EMAILS=20/minute
RATE_LIMIT_ANALYZE=10/minute
